# With no variables at all, the prototype runs in OFFLINE mode (deterministic policy engine).
# Claude API (Anthropic):
# ANTHROPIC_API_KEY=sk-ant-...
# AGIL_MODEL=claude-sonnet-5-5
# Fixed business date for reproducible demos:
# AGIL_TODAY=2026-11-02
# Amazon Bedrock:
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Force offline even if an API key is set:
# LLM_PROVIDER=mock
